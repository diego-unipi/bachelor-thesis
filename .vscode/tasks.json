{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "latex: clean",
            "type": "process",
            "command": "latexmk",
            "args": [
                "-c",
                "${workspaceFolder}\\main.tex"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "latex: build (incremental)",
            "type": "process",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "${workspaceFolder}\\main.tex"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
