{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "latex: clean",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\clean.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "latex: build+clean",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "latexmk -synctex=1 -interaction=nonstopmode -file-line-error -pdf \"${workspaceFolder}\\main.tex\"; & \"${workspaceFolder}\\.vscode\\clean.ps1\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
