{
    "cSpell.words": [
        "arit",
        "Battelle",
        "Benkhadra",
        "Bicartesian",
        "Callum",
        "Cleveref",
        "conservativity",
        "Fancyhdr",
        "Feys",
        "Grelling",
        "heterological",
        "intuitionistic",
        "Lambek",
        "LITP",
        "MBNF",
        "pdfdisplaydoctitle",
        "pdftitle",
        "prerecursive",
        "Sanchis",
        "Schauder",
        "Schöonfinkel",
        "Seely",
        "Stubbe",
        "Thibault",
        "Troelstra"
    ],
    "[latex]": {
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true
    },
    "ltex.enabled": [],
    "ltex.language": "en-US",
    "ltex.diagnosticSeverity": "information",
    "latex-workshop.view.pdf.viewer": "browser",
    "latex-workshop.latex.autoClean.run": "never",
    "latex-workshop.latex.clean.method": "glob",
    "latex-workshop.latex.clean.patterns": [
        "*.aux",
        "*.bbl",
        "*.bcf",
        "*.blg",
        "*.fdb_latexmk",
        "*.fls",
        "*.log",
        "*.out",
        "*.run.xml",
        "*.toc",
        "*.synctex.gz",
        "chapters/**/*.aux"
    ],
    "latex-workshop.latex.clean.subfolder.enabled": true,
    "latex-workshop.latex.clean.fileTypes": [
        "aux",
        "bbl",
        "bcf",
        "blg",
        "fdb_latexmk",
        "fls",
        "log",
        "out",
        "run.xml",
        "synctex.gz",
        "toc"
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-build",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (incremental)",
            "tools": [
                "latexmk-build"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "chat.notifyWindowOnConfirmation": "off",
    "chat.notifyWindowOnResponseReceived": "off"
}
